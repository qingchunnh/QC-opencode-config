{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "default_agent": "kimi",
  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "git *": "ask",
      "git reset": "deny",
      "git reset *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git rm": "deny",
      "git rm *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "rm": "deny",
      "rm *": "deny",
      "mv": "deny",
      "mv *": "deny",
      "rmdir": "deny",
      "rmdir *": "deny",
      "unlink": "deny",
      "unlink *": "deny",
      "shred": "deny",
      "shred *": "deny",
      "dd": "deny",
      "dd *": "deny",
      "truncate": "deny",
      "truncate *": "deny"
    },
    "task": "ask",
    "skill": "ask",
    "lsp": "ask",
    "todoread": "allow",
    "todowrite": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "agent": {
    "title": {
      "model": "qcapi/deepseek-v4-flash"
    },
    "kimi": {
      "mode": "primary",
      "prompt": "{file:./prompts/kimi.txt}"
    }
  },
  "disabled_providers": ["opencode"],
  "provider": {
    "qcapi": {
